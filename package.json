{
  "name": "maden360",
  "version": "0.1.0",
  "private": true,
  "description": "Türkiye Madencilik Bilgi ve Hesaplama Platformu — kaynaklı teknik rehberler ve test edilmiş hesaplayıcılar.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:onizleme": "cross-env CONTENT_PREVIEW=1 next build",
    "start": "node scripts/serve-static.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:check": "tsx scripts/validate-content.ts",
    "site:check": "node scripts/check-site.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run content:check",
    "new": "tsx scripts/new-content.ts",
    "format": "prettier --write .",
    "generate:og": "node scripts/generate-og-image.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "hast-util-to-string": "^3.0.1",
    "katex": "^0.19.0",
    "lucide-react": "^1.57.0",
    "mdast-util-find-and-replace": "^3.0.3",
    "mdast-util-to-string": "^4.0.0",
    "minisearch": "^7.2.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "parse5": "^7.3.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "katex": "$katex",
    "postcss-selector-parser": "^7.1.6"
  }
}
