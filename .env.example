# Sitenin yayındaki adresi (sonunda / olmadan). Kanonik URL, site haritası ve
# Open Graph bağlantıları bu adresle üretilir. Yayına almadan önce mutlaka ayarlayın.
SITE_URL=https://www.ornek-alan-adi.com.tr

# 1 yapılırsa "draft" ve "review" durumundaki içerikler de derlenir (yalnızca
# önizleme/inceleme ortamları için). Üretim ortamında BOŞ bırakın.
CONTENT_PREVIEW=

# İsteğe bağlı: ilan/stand başvurularının gönderileceği form hizmeti adresi.
# Boş bırakılırsa başvurular src/config/site.ts → listingsEmail adresine e-postayla
# (ziyaretçinin e-posta programı açılarak) gönderilir. Örnekler:
#   Formspree : https://formspree.io/f/xxxxxxxx
#   Web3Forms : https://api.web3forms.com/submit  (NEXT_PUBLIC_FORM_ACCESS_KEY ile)
# Yurt dışındaki hizmetler KVKK md. 9 (yurt dışına aktarım) kapsamında değerlendirilmelidir.
NEXT_PUBLIC_FORM_ENDPOINT=
NEXT_PUBLIC_FORM_ACCESS_KEY=
